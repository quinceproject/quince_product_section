{% trans_default_domain 'Modules.Quinceproductsection.Admin' %}

{# Jeden rząd polecanych: wiersz listy, a pod strzałką jego ustawienia.
   Pola stoją bez nazw formularzowych (pierwszy argument makr pól jest pusty):
   wiersz jest jedną z wielu kopii tego samego znacznika, a całą listę spisuje
   skrypt ekranu do jednego pola JSON przy wysyłce, tak jak sekcje strony
   głównej. #}
{% macro sekcja(sekcja, algorithms, languages, iconsRoute, showSubcats, numer) %}
    {% import '@Modules/quince_engine/views/templates/admin/_macros/icons.html.twig' as icons %}
    {% import '@Modules/quince_engine/views/templates/admin/_macros/fields.html.twig' as fields %}

    <div class="qc-rep-row" data-sekcja x-sort:item="'{{ sekcja.id|default('section') }}'">
        <div class="qc-rep-row-head" data-pasek>
            <span class="qc-rep-handle" x-sort:handle title="{{ 'Drag to reorder'|trans }}">{{ icons.icon('drag', 14) }}</span>

            <span class="qc-rep-name">
                <span data-nazwa>{{ 'Section'|trans }} {{ numer }}</span>
                <span class="qc-rep-sub" data-opis></span>
            </span>

            <div class="qc-rep-actions">
                <span data-pole="active">{{ fields.toggle('', sekcja.active|default(true)) }}</span>

                <button type="button" class="qc-icon-btn" data-rozwin title="{{ 'Settings'|trans }}">
                    {{ icons.icon('chevronDown', 14, 'qc-strzalka') }}
                </button>

                <button type="button" class="qc-icon-btn qc-danger" data-usun-sekcje title="{{ 'Remove'|trans }}">
                    {{ icons.icon('trash', 14) }}
                </button>
            </div>
        </div>

        <div class="qc-rep-body" hidden>
            <input type="hidden" data-pole="id" value="{{ sekcja.id|default('') }}">

            <div class="qc-stack">
                <div class="qc-form-grid qc-form-grid-3">
                    <div class="qc-field">
                        <label class="qc-label">{{ 'How products are picked'|trans }}</label>
                        <div class="qc-select-wrap">
                            <select class="qc-field-base qc-select qc-focusable" data-pole="algorithm">
                                {% for wartosc, nazwa in algorithms %}
                                    <option value="{{ wartosc }}"{{ (sekcja.algorithm|default('bestselling')) == wartosc ? ' selected' : '' }}>{{ nazwa|trans }}</option>
                                {% endfor %}
                            </select>
                            {{ icons.icon('chevronDown', 14, 'qc-select-chevron') }}
                        </div>
                    </div>

                    <div class="qc-field">
                        <label class="qc-label">{{ 'How many products'|trans }}</label>
                        <input type="number" class="qc-field-base qc-focusable" data-pole="count"
                               value="{{ sekcja.count|default(4) }}" min="1" max="24" step="1">
                    </div>

                    <div class="qc-field">
                        <label class="qc-label">{{ 'Show the row from'|trans }}</label>
                        <input type="number" class="qc-field-base qc-focusable" data-pole="threshold"
                               value="{{ sekcja.threshold|default(0) }}" min="0" step="1">
                        <div class="qc-hint">{{ 'Below this many products the row does not show at all. 0 means it always shows.'|trans }}</div>
                    </div>
                </div>

                {# Ręczny wybór: lista numerów produktów zamiast doboru. Skrypt
                   ekranu pokazuje to pole tylko, gdy wybrany jest ten sposób. #}
                <div class="qc-field" data-gdy-algorytm="manual" hidden>
                    <label class="qc-label">{{ 'Product numbers, separated by commas'|trans }}</label>
                    <input type="text" class="qc-field-base qc-focusable" data-pole="ids"
                           value="{{ sekcja.ids|default('') }}" placeholder="12, 7, 340">
                    <div class="qc-hint">{{ 'Products show in the order you type them. The number is in the address of the product page in the catalogue.'|trans }}</div>
                </div>

                <span data-pole="exclude_listing">{{ fields.toggle('', sekcja.exclude_listing|default(true),
                    'Leave out products already shown on the list above'|trans) }}</span>

                {% if showSubcats %}
                    <span data-pole="subcats">{{ fields.toggle('', sekcja.subcats|default(false),
                        'Also take products from subcategories'|trans) }}</span>
                {% endif %}

                <span data-pole="title">{{ fields.multilang('', 'Heading above the row'|trans, languages,
                    sekcja.title|default({}), 'Recommended'|trans) }}</span>

                <div class="qc-form-grid qc-form-grid-2">
                    <div class="qc-field">
                        <label class="qc-label">{{ 'Icon next to the heading'|trans }}</label>
                        <span data-pole="icon">{{ fields.iconpicker('', sekcja.icon|default(''), sekcja.icon_svg|default(''), path(iconsRoute)) }}</span>
                    </div>

                    <div class="qc-field">
                        <span data-pole="arrows">{{ fields.toggle('', sekcja.arrows|default(true), 'Arrows for scrolling the row'|trans) }}</span>
                        <div class="qc-hint">{{ 'On a phone the row is always swiped by finger, arrows show on wide screens only.'|trans }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endmacro %}
